NODE_ENV=development
PORT=3000

# Two connection URLs, two Postgres roles:
#
# DATABASE_URL: the app at runtime, as orbyte_app. That role is created by
# the migrations (NOLOGIN, no superuser, no BYPASSRLS, owns nothing), so
# Row-Level Security applies to it. Its password is set from this URL by
# `pnpm db:app-login`, run as the owner. The app refuses to start if this URL
# connects as a superuser or a BYPASSRLS role.
DATABASE_URL=postgres://orbyte_app:orbyte_app@localhost:5435/orbyte
#
# DATABASE_MIGRATION_URL: the role that owns the tables. Used by migrations,
# db:app-login, the seed and the e2e setup; never by the running app.
# Locally: the docker-compose superuser.
DATABASE_MIGRATION_URL=postgres://orbyte:orbyte@localhost:5435/orbyte
#
# Supabase (managed), for reference:
#   DATABASE_MIGRATION_URL: the "postgres" role on the direct connection
#     (db.<ref>.supabase.co:5432) or the session pooler.
#   DATABASE_URL: orbyte_app on the transaction pooler, where Supavisor
#     expects the user as orbyte_app.<project-ref>, e.g.
#     postgres://orbyte_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (SET LOCAL is transaction-scoped, so transaction pooling is safe.)

# true for managed Postgres providers (SSL without a verifiable chain).
DATABASE_SSL=false

# HS256 signing secret, at least 32 characters (the app refuses to start
# otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# jsonwebtoken format: 15m, 1h, 7d...
JWT_EXPIRES_IN=1h
