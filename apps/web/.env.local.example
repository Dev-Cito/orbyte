# Base URL of the Orbyte API (apps/api, NestJS).
# Only the Next.js server calls it: the browser talks to this app's own
# /api/* route handlers, which hold the session cookie and forward requests
# with "Authorization: Bearer <token>". So the API needs no CORS for the web
# app, and the token never reaches browser JavaScript.
# (NEXT_PUBLIC_ makes the value visible in the client bundle too; it is just
# a URL, nothing secret.)
NEXT_PUBLIC_API_URL=http://localhost:3000
