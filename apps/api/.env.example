NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://orbyte:orbyte@localhost:5435/orbyte
# true for managed Postgres providers (SSL without a verifiable chain).
DATABASE_SSL=false
# Schema is managed by migrations (pnpm migration:run). Set to true only for
# throwaway local experiments; always ignored when NODE_ENV=production.
DATABASE_SYNCHRONIZE=false

# HS256 signing secret, at least 32 characters (the app refuses to start
# otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# jsonwebtoken format: 15m, 1h, 7d...
JWT_EXPIRES_IN=1h
